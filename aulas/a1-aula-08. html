/* ===============================
   YOUR TURN — RECORDING
================================ */

let recorders = {};


async function toggleRecording(
  number
){

  const status =
    document.getElementById(
      "recordStatus" + number
    );


  if(
    recorders[number] &&
    recorders[number].state !==
    "inactive"
  ){

    recorders[number].stop();

    return;

  }


  if(
    !navigator.mediaDevices ||
    !navigator.mediaDevices.getUserMedia
  ){

    status.innerText =
      "Microphone recording is not supported.";

    return;

  }


  try{

    const stream =
      await navigator.mediaDevices
        .getUserMedia({
          audio:true
        });


    const recorder =
      new MediaRecorder(
        stream
      );

    recorders[number] =
      recorder;


    let chunks = [];


    recorder.ondataavailable =
      function(event){

        if(
          event.data.size > 0
        ){

          chunks.push(
            event.data
          );

        }

      };


    recorder.onstop =
      function(){

        stream
          .getTracks()
          .forEach(
            function(track){

              track.stop();

            }
          );

        status.innerText =
          "✓ Recording complete!";

        addXP(5);

      };


    recorder.start();


    status.innerText =
      "🔴 Recording... toque novamente para parar.";

  }catch(error){

    status.innerText =
      "Permita o acesso ao microfone.";

  }

}


