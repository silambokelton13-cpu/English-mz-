<script>

/* ===============================
   XP
================================ */

let xp =
Number(
localStorage.getItem("englishMZ_xp")
) || 0;


function updateXP(){

document.getElementById(
"xp"
).innerText = xp;

}


function addXP(amount){

xp += amount;

localStorage.setItem(
"englishMZ_xp",
xp
);

updateXP();

}


/* ===============================
   VOICE
================================ */

function stopVoice(){

if(
window.speechSynthesis
){

speechSynthesis.cancel();

}

}


function speak(text,lang){

if(
!window.speechSynthesis
){

return;

}

stopVoice();

const voice =
new SpeechSynthesisUtterance(
text
);

voice.lang =
lang;

voice.rate =
0.88;

speechSynthesis.speak(
voice
);

}


function speakEN(text){

speak(
text,
"en-US"
);

}


function speakPT(text){

speak(
text,
"pt-PT"
);

}


/* ===============================
   NAVIGATION
================================ */

function goToScreen(number){

stopVoice();

document
.querySelectorAll(".screen")
.forEach(
function(screen){

screen.classList.remove(
"active"
);

}
);

const target =
document.getElementById(
"screen" + number
);

if(!target){

return;

}

target.classList.add(
"active"
);

const progress =
Math.min(
((number - 1) / 12) * 100,
100
);

document.getElementById(
"progressFill"
).style.width =
progress + "%";

document.getElementById(
"progressText"
).innerText =
number + "/13";

window.scrollTo({
top:0,
behavior:"smooth"
});


if(number === 6){

loadCountries();

}

if(number === 7){

prepareListening();

}

if(number === 8){

prepareSentence();

}

if(number === 9){

prepareChoose();

}

if(number === 11){

prepareThink();

}

if(number === 12){

challengeIndex = 0;

challengeScore = 0;

loadChallenge();

}

}


/* ===============================
   COUNTRIES
================================ */

const countries = [

{
flag:"🇲🇿",
en:"Mozambique",
pt:"Moçambique"
},

{
flag:"🇿🇦",
en:"South Africa",
pt:"África do Sul"
},

{
flag:"🇿🇼",
en:"Zimbabwe",
pt:"Zimbábue"
},

{
flag:"🇦🇴",
en:"Angola",
pt:"Angola"
},

{
flag:"🇧🇷",
en:"Brazil",
pt:"Brasil"
},

{
flag:"🇵🇹",
en:"Portugal",
pt:"Portugal"
},

{
flag:"🇺🇸",
en:"United States",
pt:"Estados Unidos"
},

{
flag:"🇬🇧",
en:"United Kingdom",
pt:"Reino Unido"
}

];


function loadCountries(){

const grid =
document.getElementById(
"countriesGrid"
);

grid.innerHTML = "";

countries.forEach(
function(country){

const div =
document.createElement(
"div"
);

div.className =
"country";

div.innerHTML = `

<span class="flag">
${country.flag}
</span>

<div class="countryName">
${country.en}
</div>

<div class="countryPT">
${country.pt}
</div>

<button
class="audioButton"
onclick="speakEN('${country.en}')">

🔊

